# Dashboard port only. Discord token/channel are stored locally in data/accounts.json.
PORT=3000

# Enable/disable scheduled tasks
ENABLE_TL=true
ENABLE_TRANYEU=true
ENABLE_PVP=true
ENABLE_TLT=true

# Optional AI reply (requires local Ollama)
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
AI_POLL_INTERVAL_MS=5000
AI_COOLDOWN_MS=5000
